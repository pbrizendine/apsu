{
  "name": "apsu-worlds",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "main": "worker/index.mjs",
  "ratelimits": [
    { "name": "SOLO_LIMIT", "namespace_id": "1002", "simple": { "limit": 12, "period": 60 } },
    {
      "name": "IMAGINE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 1,
        "period": 60,
      },
    },
  ],
}
